<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4A6CF7"> <!-- Fallback color -->
    
    <!-- Gradient Background roughly -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient_blue"/>

    <!-- Content Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:layout_centerInParent="true"
        app:cardCornerRadius="32dp"
        app:cardElevation="16dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_check" 
                app:tint="#4A6CF7"/> 

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="وقت الدواء!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center"
                android:layout_marginTop="24dp"/>

            <TextView
                android:id="@+id/tvMedicineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="اسم الدواء"
                android:textSize="28sp"
                android:textColor="#4A6CF7"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>

            <TextView
                android:id="@+id/tvDose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الجرعة"
                android:textSize="20sp"
                android:textColor="#666666"
                android:layout_marginTop="8dp"/>
                
        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Stop Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopAlarm"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:text="إيقاف التنبيه"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="60dp"
        android:backgroundTint="#E53935"
        app:cornerRadius="30dp"
        app:elevation="8dp"/>

</RelativeLayout>
